{
  "name": "biechihui-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "backend:build-win": "python backend/build_desktop_backend.py --output-name desktop-backend-x86_64-pc-windows-msvc.exe",
    "backend:build-macos:x64": "python backend/build_desktop_backend.py --output-name desktop-backend-x86_64-apple-darwin",
    "backend:build-macos:arm64": "python backend/build_desktop_backend.py --output-name desktop-backend-aarch64-apple-darwin",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:dist-win": "npm run build && npm run backend:build-win && tauri build",
    "desktop:dist-macos:x64": "npm run build && npm run backend:build-macos:x64 && tauri build --target x86_64-apple-darwin --bundles app dmg --no-sign",
    "desktop:dist-macos:arm64": "npm run build && npm run backend:build-macos:arm64 && tauri build --target aarch64-apple-darwin --bundles app dmg --no-sign",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "tsc -b"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.80.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.515.0",
    "motion": "^12.23.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "react-router-dom": "^7.6.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.64",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.14",
    "@tauri-apps/cli": "^2.11.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  }
}
